{
  "name": "catalog-sync",
  "version": "1.0.0",
  "description": "Collects, normalizes, and syncs artisan, keyset, keyboard, and image data from Google Docs and maker or vendor websites into Keebdex.",
  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,ts}\"",
    "gdocs-importer": "node artisans/gdocs-importer.js",
    "maker-scraper": "node artisans/maker-scraper.js",
    "vendor-scraper": "node keysets/vendor-scraper.js",
    "sync-images": "node jobs/sync-images.js",
    "prune-images": "node jobs/prune-images.js",
    "backup-images": "node jobs/backup-images.js",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keebdex/catalog-sync.git"
  },
  "author": "Anh Thang Bui <buianhthang89@gmail.com> (https://anhthang.org)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/keebdex/catalog-sync/issues"
  },
  "homepage": "https://github.com/keebdex/catalog-sync#readme",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@googleapis/docs": "^14.1.1",
    "@googleapis/drive": "^26.0.2",
    "@supabase/supabase-js": "^2.117.3",
    "axios": "^1.20.0",
    "bluebird": "^3.7.2",
    "cheerio": "^1.2.0",
    "crc": "^4.3.2",
    "date-fns": "^4.4.0",
    "deepmerge": "^4.3.1",
    "dotenv": "^18.0.8",
    "google-auth-library": "^11.3.0",
    "husky": "^9.1.7",
    "ini": "^7.0.0",
    "lodash": "^4.18.1",
    "slugify": "^1.6.9"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
